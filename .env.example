# Copy to .env and edit.  Nothing secret is ever committed to git.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE = sqlite (zero setup, for development) | mysql (for deployment)
DB_ENGINE=sqlite
DB_NAME=civicsense
DB_USER=civic
DB_PASSWORD=civic
DB_HOST=127.0.0.1
DB_PORT=3306
