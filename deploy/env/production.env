# Production: secrets are generated on the first deployment in
# ~/.civicsense/production/secrets.env and never committed.
ENV_NAME=production
PROJECT=civic-production
PUBLIC_PORT=8092
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8092,https://127.0.0.1:8092
DJANGO_LOG_LEVEL=WARNING
GUNICORN_WORKERS=3
# No demonstration data (and so no demo passwords) in production.
LOAD_DEMO_DATA=0
