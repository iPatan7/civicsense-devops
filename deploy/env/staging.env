# Staging: same images and same deployment code as production, smaller settings.
# Secrets are not kept here; ci/deploy.sh generates them on the first deployment
# in ~/.civicsense/staging/secrets.env, outside the repository.
ENV_NAME=staging
PROJECT=civic-staging
PUBLIC_PORT=8091
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8091,http://127.0.0.1:8091
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=2
LOAD_DEMO_DATA=1
